# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# prisma (base SQLite locale + client généré)
/prisma/*.db
/prisma/*.db-journal
/src/generated

# outillage local (preview, settings Claude Code)
.claude/

.vercel

# Photos clientes : ne déployer que des WebP compressés (voir src/data/testimonials.ts).
public/customer-reviews/*.png

# worker MapLibre copié au build (scripts/copy-maplibre-worker.mjs)
/public/maplibre/
