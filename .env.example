# Boutique active (dossier src/stores/<id>) — inlinée au build : un build par
# boutique. Vide = "demo".
NEXT_PUBLIC_STORE_ID="demo"

# Base de données — PostgreSQL (une base par boutique)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/boutique"

# Auth.js — générer : npx auth secret
AUTH_SECRET=""

# Stripe — clés du compte client (test puis live) + secret du webhook
STRIPE_SECRET_KEY="sk_test_..."
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY="pk_test_..."
STRIPE_WEBHOOK_SECRET="whsec_..."

# Resend — e-mails transactionnels (clé + domaine expéditeur vérifié SPF/DKIM)
RESEND_API_KEY="re_..."
EMAIL_FROM="Nom Boutique <commandes@domaine-boutique.fr>"

# URL publique du site — sert de REPLI uniquement. En production, l'origine est
# dérivée de la requête (x-forwarded-host), pour que chaque domaine renvoie ses
# propres canonicals, sitemap et liens.
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# --- Répartition multi-domaine (international) ---
# Langues servies : config.locales de la boutique (français seul par défaut).
# Laisser NEXT_PUBLIC_DOMAIN_INTL VIDE conserve le comportement mono-domaine :
# toutes les langues activées sur le même hôte, avec les préfixes /en et /he.
# La renseigner active : français sur le domaine principal, autres langues sur
# le domaine international, avec redirections 301 croisées (src/lib/domains.ts).
# Vides : domaines de src/stores/<id>/config.ts.
# NEXT_PUBLIC_DOMAIN_FR="domaine-boutique.fr"
NEXT_PUBLIC_DOMAIN_INTL=""

# Ouvre l'indexation des versions traduites (X-Robots-Tag + sitemap).
# À ne passer à "true" qu'une fois le contenu traduit ET relu.
NEXT_PUBLIC_ALLOW_INTL_INDEXING="false"

# Cloudinary - cloud name public + identifiants serveur pour upload/migration
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""

# Admin — l'accès /admin dépend du RÔLE en base (User.role = OWNER | STAFF),
# créé avec `npm run admin:create -- <email>`. ADMIN_EMAILS (séparés par des
# virgules) sert à : recevoir les alertes, interdire l'inscription publique avec
# ces adresses, et amorcer (un compte existant listé est promu OWNER).
ADMIN_EMAILS=""
# "off" désactive la promotion automatique depuis ADMIN_EMAILS (après amorçage).
ADMIN_EMAILS_BOOTSTRAP=""

# Secrets de cron (header x-cron-secret) — endpoints planifiés
# Nettoyage des sessions Live inactives : POST /api/live/cleanup
LIVE_CLEANUP_SECRET=""
# Relance des paniers abandonnés (1 h · 24 h · 72 h) : POST /api/carts/relance
CART_RELANCE_SECRET=""
