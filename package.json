{
  "name": "boutique-modele",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "predev": "node scripts/select-store.mjs && node scripts/copy-maplibre-worker.mjs",
    "dev": "next dev",
    "prebuild": "node scripts/select-store.mjs && node scripts/copy-maplibre-worker.mjs",
    "build": "next build",
    "start": "prisma migrate deploy && node scripts/store-content-sync.cjs && next start",
    "lint": "eslint",
    "store:new": "node scripts/store-new.mjs",
    "store:plan": "node scripts/store-provision-plan.mjs",
    "postinstall": "prisma generate",
    "db:studio": "prisma studio",
    "db:seed": "tsx prisma/seed.ts",
    "admin:create": "node scripts/admin-account.cjs create",
    "admin:role": "node scripts/admin-account.cjs role",
    "content:sync": "node scripts/store-content-sync.cjs",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy"
  },
  "dependencies": {
    "@auth/prisma-adapter": "2.11.3",
    "@stripe/stripe-js": "^9.8.0",
    "bcryptjs": "^3.0.3",
